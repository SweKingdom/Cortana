<UserControl x:Class="Companion.Character.OrbControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="168" Height="168" Background="{x:Null}">
    <!-- The control and window surround keep Background=null: fully transparent pixels let clicks through.
         The only hit-testable area is the grab ring (D-049); the glow ends inside it. The orb is built by
         OrbVisual (single source for the look) and added to Host in code. -->
    <Grid Background="{x:Null}">
        <!-- Grab ring: 104 px core + 24 px each side, alpha 1/255 so it is invisible but still part of the window. -->
        <Ellipse Width="152" Height="152" Fill="#01000000" />
        <Grid x:Name="Host" Background="{x:Null}" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5" />
    </Grid>
</UserControl>
