<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Companion</AssemblyName>
    <RootNamespace>Companion</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Companion.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Brain\default.personality.normal.json" LogicalName="personality.normal.json" />
    <!-- The version 1 default shipped in step 3, kept only to recognise an unedited copy and upgrade it (D-074). -->
    <EmbeddedResource Include="Brain\personality.v1.default.json" LogicalName="personality.v1.default.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="System.Speech" Version="10.0.15" />
  </ItemGroup>

</Project>
